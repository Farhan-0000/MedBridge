GROQ_API_KEY=
OPENAI_API_KEY=
POSTGRES_PASSWORD=
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE_GATES=0.0
LLM_TEMPERATURE_GENERATOR=0.3
LLM_MAX_TOKENS_GATES=512
LLM_MAX_TOKENS_GENERATOR=1024
LLM_SEED=42
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

DATABASE_URL=postgresql+asyncpg://medbridge_app:password@127.0.0.1:5432/medbridge

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=clinical_guidelines

RETRIEVAL_TOP_K_CANDIDATES=20
RETRIEVAL_TOP_K_RERANKED=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

SOFT_ASK_MAX_COUNT=2

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:8501"]
